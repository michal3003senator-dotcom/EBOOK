# Baza (SQLite; plik tworzony automatycznie)
DATABASE_URL="file:./data/app.db"

# Publiczny adres sklepu (bez / na końcu)
APP_URL="http://localhost:3000"
# Domena dla HTTPS (docker-compose + Caddy), np. sklep.twojadomena.pl
DOMAIN=""

# Min. 32 losowe znaki: openssl rand -base64 48
SESSION_SECRET="zmien-mnie-na-dlugi-losowy-ciag-znakow-min-32"

# Pierwsze konto admina (tworzone przez `npm run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="zmien-to-haslo"

# Bramka płatności: mock | stripe
PAYMENT_PROVIDER="mock"
# Tryb testowy na produkcji wymaga jawnej zgody:
ALLOW_MOCK_PAYMENTS="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# E-mail (puste = wiadomości tylko w logu/panelu)
SMTP_URL=""
MAIL_FROM="Faceless Cash-Cow <sklep@example.com>"

# Katalog plików prywatnych (PDF, cache)
STORAGE_DIR="./storage"
